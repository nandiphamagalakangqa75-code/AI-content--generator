<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NandiGen AI - Intelligent Content Studio</title>

    <meta name="description"
        content="NandiGen AI is an AI-powered content generation project developed by Nandipha Magalakangqa, a Software Engineer Practitioner.">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <div class="container">

            <h1>NandiGen AI</h1>

            <h2>Intelligent Content Studio</h2>

            <p>
                AI-Powered Content Generation for Creators,
                Students, Professionals and Businesses
            </p>

            <p>
                Built by <strong>Nandipha Magalakangqa</strong>
            </p>

            <p>
                Software Engineer Practitioner | Portfolio Project
            </p>

        </div>
    </header>


    <!-- Main Content -->
    <main>

        <div class="container">

            <!-- Content Generator -->
            <section class="generator">

                <h2>Create Content with AI</h2>

                <p>
                    Enter a topic or prompt below and generate
                    content quickly and efficiently.
                </p>


                <!-- Content Type -->
                <label for="contentType">
                    Select Content Type
                </label>

                <select id="contentType">

                    <option value="blog">
                        Blog Post
                    </option>

                    <option value="social">
                        Social Media Post
                    </option>

                    <option value="article">
                        Article
                    </option>

                    <option value="product">
                        Product Description
                    </option>

                    <option value="marketing">
                        Marketing Content
                    </option>

                </select>


                <!-- Prompt -->
                <label for="prompt">
                    Enter Your Topic or Prompt
                </label>

                <textarea
                    id="prompt"
                    placeholder="Example: Write a blog post about the benefits of Artificial Intelligence for small businesses..."
                ></textarea>


                <!-- Generate Button -->
                <button class="generate-btn">
                    Generate Content
                </button>


                <!-- Generated Content -->
                <section class="output" style="display: none;">

                    <h2>Generated Content</h2>

                    <div class="output-content"></div>

                </section>

            </section>


            <!-- About Project -->
            <section class="about-project">

                <h2>About NandiGen AI</h2>

                <p>
                    NandiGen AI is an AI-powered content generation
                    project developed by Nandipha Magalakangqa,
                    a Software Engineer Practitioner.
                </p>

                <p>
                    The project explores how Generative AI and
                    Natural Language Processing can be used to
                    support content creation, improve productivity,
                    and make writing more accessible.
                </p>

            </section>


            <!-- Prompt Library -->
            <section class="prompt-library">

                <h2>Prompt Library</h2>

                <p>
                    NandiGen AI uses a structured prompt library
                    designed to guide AI-generated content.
                    The library contains prompts for different
                    content creation needs.
                </p>

                <ul>

                    <li>
                        Blog post generation
                    </li>

                    <li>
                        Social media content
                    </li>

                    <li>
                        Article generation
                    </li>

                    <li>
                        Product descriptions
                    </li>

                    <li>
                        Marketing content
                    </li>

                </ul>

            </section>


            <!-- AI Tool -->
            <section class="ai-tool">

                <h2>AI Generation Tool</h2>

                <p>
                    NandiGen AI is designed to use an AI model
                    to process user prompts and generate
                    relevant and engaging content.
                </p>

                <p>
                    The AI generation API and model will be
                    integrated as the project develops.
                </p>

            </section>


            <!-- Developer -->
            <section class="developer">

                <h2>About the Developer</h2>

                <p>
                    <strong>Nandipha Magalakangqa</strong>
                </p>

                <p>
                    Software Engineer Practitioner
                </p>

                <p>
                    NandiGen AI is my first AI-focused portfolio
                    project. It represents my journey into
                    software engineering, Generative AI and
                    Natural Language Processing.
                </p>

            </section>

        </div>

    </main>


    <!-- Footer -->
    <footer>

        <div class="container">

            <p>
                &copy; 2026 Nandipha Magalakangqa
            </p>

            <p>
                NandiGen AI - Intelligent Content Studio
            </p>

            <p>
                Software Engineer Practitioner | Portfolio Project
            </p>

        </div>

    </footer>


    <!-- JavaScript -->
    <script src="script.js"></script>

</body>

</html>
