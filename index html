<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NandiGen AI - Intelligent Content Studio</title>

    <meta name="description"
        content="NandiGen AI is an AI-powered content generation project developed by Nandipha Magalakangqa, a Software Engineer Practitioner.">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ==============================
         Header
    =============================== -->

    <header>
        <div class="container">

            <h1>NandiGen AI</h1>

            <h2>Intelligent Content Studio</h2>

            <p>
                AI-Powered Content Generation for Creators,
                Students, Professionals and Businesses
            </p>

            <p>
                Built by <strong>Nandipha Magalakangqa</strong>
            </p>

            <p>
                Software Engineer Practitioner | Portfolio Project
            </p>

        </div>
    </header>


    <!-- ==============================
         Main Content
    =============================== -->

    <main>

        <div class="container">


            <!-- ==============================
                 AI Content Generator
            =============================== -->

            <section class="generator">

                <h2>Create Content with AI</h2>

                <p>
                    Enter a topic or prompt below and choose the
                    type of content you would like NandiGen AI
                    to prepare.
                </p>


                <!-- Content Type -->

                <label for="contentType">
                    Select Content Type
                </label>

                <select id="contentType">

                    <option value="blog">
                        Blog Post
                    </option>

                    <option value="social">
                        Social Media Post
                    </option>

                    <option value="article">
                        Article
                    </option>

                    <option value="product">
                        Product Description
                    </option>

                    <option value="marketing">
                        Marketing Content
                    </option>

                </select>


                <!-- User Prompt -->

                <label for="prompt">
                    Enter Your Topic or Prompt
                </label>

                <textarea
                    id="prompt"
                    placeholder="Example: Write a blog post about the benefits of Artificial Intelligence for small businesses..."
                ></textarea>


                <!-- Generate Button -->

                <button
                    type="button"
                    class="generate-btn">
                    Generate Content
                </button>


                <!-- Generated Content -->

                <section
                    class="output"
                    style="display: none;">

                    <h2>Generated Content</h2>

                    <div class="output-content"></div>

                </section>

            </section>


            <!-- ==============================
                 About NandiGen AI
            =============================== -->

            <section class="about-project">

                <h2>About NandiGen AI</h2>

                <p>
                    NandiGen AI is an AI-powered content generation
                    project developed by Nandipha Magalakangqa,
                    a Software Engineer Practitioner.
                </p>

                <p>
                    The project explores how Generative AI and
                    Natural Language Processing (NLP) can support
                    content creation, improve productivity and
                    make writing more accessible.
                </p>

                <p>
                    This is my first AI-focused portfolio project
                    and forms part of my journey into software
                    engineering and artificial intelligence.
                </p>

            </section>


            <!-- ==============================
                 Prompt Library
            =============================== -->

            <section class="prompt-library">

                <h2>Prompt Library</h2>

                <p>
                    NandiGen AI uses a structured prompt library
                    to guide content generation. Different prompt
                    templates are used depending on the type of
                    content selected by the user.
                </p>

                <ul>

                    <li>
                        Blog Post Generation
                    </li>

                    <li>
                        Social Media Content
                    </li>

                    <li>
                        Article Generation
                    </li>

                    <li>
                        Product Descriptions
                    </li>

                    <li>
                        Marketing Content
                    </li>

                </ul>

            </section>


            <!-- ==============================
                 AI Generation Technology
            =============================== -->

            <section class="ai-tool">

                <h2>AI Generation Technology</h2>

                <p>
                    NandiGen AI is designed to process user
                    prompts and use an AI model to generate
                    relevant and engaging content.
                </p>

                <p>
                    The AI model and API integration will be
                    added as the project develops.
                </p>

            </section>


            <!-- ==============================
                 Developer
            =============================== -->

            <section class="developer">

                <h2>About the Developer</h2>

                <p>
                    <strong>
                        Nandipha Magalakangqa
                    </strong>
                </p>

                <p>
                    Software Engineer Practitioner
                </p>

                <p>
                    NandiGen AI is my first AI-focused portfolio
                    project. Through this project, I am developing
                    practical skills in HTML, CSS, JavaScript,
                    Generative AI, Natural Language Processing
                    and software development.
                </p>

            </section>

        </div>

    </main>


    <!-- ==============================
         Footer
    =============================== -->

    <footer>

        <div class="container">

            <p>
                &copy; 2026 Nandipha Magalakangqa
            </p>

            <p>
                NandiGen AI - Intelligent Content Studio
            </p>

            <p>
                Software Engineer Practitioner | Portfolio Project
            </p>

        </div>

    </footer>


    <!-- JavaScript -->

    <script src="script.js"></script>

</body>

</html>
