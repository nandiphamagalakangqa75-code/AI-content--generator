/* General page styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #1f2937;
    line-height: 1.6;
}

/* Main container */
.container {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
}

/* Header */
header {
    background: #4f46e5;
    color: white;
    padding: 20px 0;
    text-align: center;
}

header h1 {
    font-size: 2rem;
    margin-bottom: 5px;
}

header p {
    font-size: 1rem;
    opacity: 0.9;
}

/* Main content */
main {
    padding: 40px 0;
}

.generator {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

/* Form elements */
label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

textarea,
select,
input {
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
}

textarea {
    min-height: 150px;
    resize: vertical;
}

textarea:focus,
select:focus,
input:focus {
    outline: none;
    border-color: #4f46e5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
}

/* Generate button */
.generate-btn {
    width: 100%;
    padding: 14px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
}

.generate-btn:hover {
    background: #4338ca;
}

/* Generated content section */
.output {
    margin-top: 30px;
    padding: 25px;
    background: #f9fafb;
    border-left: 4px solid #4f46e5;
    border-radius: 8px;
}

.output h2 {
    margin-bottom: 15px;
    color: #111827;
}

.output-content {
    white-space: pre-wrap;
    color: #374151;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    color: #6b7280;
    font-size: 0.9rem;
}

/* Responsive design */
@media (max-width: 600px) {
    .container {
        width: 95%;
    }

    .generator {
        padding: 20px;
    }

    header h1 {
        font-size: 1.5rem;
    }
}
