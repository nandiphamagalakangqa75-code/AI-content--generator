/* ==========================================
   Global Styles
   ========================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f7fb;
    color: #1f2937;
    line-height: 1.6;
}


/* ==========================================
   Container
   ========================================== */

.container {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
}


/* ==========================================
   Header
   ========================================== */

header {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: white;
    text-align: center;
    padding: 60px 20px;
}

header h1 {
    font-size: 3rem;
    margin-bottom: 10px;
}

header h2 {
    font-size: 1.6rem;
    font-weight: normal;
    margin-bottom: 20px;
}

header p {
    margin: 8px 0;
    font-size: 1rem;
}

header strong {
    font-weight: bold;
}


/* ==========================================
   Main Content
   ========================================== */

main {
    padding: 50px 0;
}

main section {
    margin-bottom: 35px;
}


/* ==========================================
   Generator
   ========================================== */

.generator {
    background: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.generator h2 {
    color: #4f46e5;
    margin-bottom: 10px;
}

.generator > p {
    margin-bottom: 25px;
    color: #6b7280;
}


/* ==========================================
   Form Elements
   ========================================== */

label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
    margin-top: 20px;
}

select,
textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background: white;
}

textarea {
    min-height: 160px;
    resize: vertical;
}

select:focus,
textarea:focus {
    outline: none;
    border-color: #4f46e5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
}


/* ==========================================
   Generate Button
   ========================================== */

.generate-btn {
    width: 100%;
    margin-top: 20px;
    padding: 14px 20px;
    border: none;
    border-radius: 8px;
    background: #4f46e5;
    color: white;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s ease;
}

.generate-btn:hover {
    background: #4338ca;
    transform: translateY(-1px);
}

.generate-btn:active {
    transform: translateY(0);
}


/* ==========================================
   Generated Content
   ========================================== */

.output {
    margin-top: 30px;
    padding: 25px;
    background: #f9fafb;
    border-left: 5px solid #4f46e5;
    border-radius: 8px;
}

.output h2 {
    margin-bottom: 15px;
    color: #111827;
}

.output-content {
    white-space: pre-wrap;
    color: #374151;
    line-height: 1.8;
}


/* ==========================================
   About Project Sections
   ========================================== */

.about-project,
.prompt-library,
.ai-tool,
.developer {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
}

.about-project h2,
.prompt-library h2,
.ai-tool h2,
.developer h2 {
    color: #4f46e5;
    margin-bottom: 15px;
}

.about-project p,
.ai-tool p,
.developer p {
    margin-bottom: 12px;
}


/* ==========================================
   Prompt Library
   ========================================== */

.prompt-library ul {
    margin-top: 15px;
    padding-left: 25px;
}

.prompt-library li {
    margin-bottom: 8px;
}


/* ==========================================
   Developer Section
   ========================================== */

.developer {
    border-top: 4px solid #7c3aed;
}

.developer strong {
    font-size: 1.2rem;
}


/* ==========================================
   Footer
   ========================================== */

footer {
    background: #111827;
    color: #d1d5db;
    text-align: center;
    padding: 30px 20px;
}

footer p {
    margin: 5px 0;
}


/* ==========================================
   Responsive Design
   ========================================== */

@media (max-width: 768px) {

    header {
        padding: 45px 15px;
    }

    header h1 {
        font-size: 2.3rem;
    }

    header h2 {
        font-size: 1.3rem;
    }

    .generator,
    .about-project,
    .prompt-library,
    .ai-tool,
    .developer {
        padding: 25px;
    }

    main {
        padding: 30px 0;
    }
}


@media (max-width: 480px) {

    header h1 {
        font-size: 2rem;
    }

    header h2 {
        font-size: 1.1rem;
    }

    .container {
        width: 94%;
    }

    .generator,
    .about-project,
    .prompt-library,
    .ai-tool,
    .developer {
        padding: 20px;
    }
}
